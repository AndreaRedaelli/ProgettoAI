# Copia questo file in ".env" e inserisci la chiave del fornitore che usi.

# Quale AI usare: groq (gratuito, predefinito) oppure anthropic
AI_PROVIDER=groq

# Chiave Groq: si crea su https://console.groq.com
GROQ_API_KEY=

# Chiave Anthropic (a pagamento): si crea su https://console.anthropic.com
ANTHROPIC_API_KEY=

# Facoltativo: modello da usare. Se vuoto, vale il predefinito del fornitore:
#   groq      -> openai/gpt-oss-120b
#   anthropic -> claude-opus-5-5 (alternative: claude-sonnet-5-5, claude-haiku-5-5)
MODELLO=

# Facoltativo, solo Anthropic: quanto "si impegna" il modello (low, medium, high)
EFFORT=medium

# --- Sicurezza (tutte facoltative) ---
# Funzione prevista dell'assistente: le richieste fuori ambito vengono bloccate.
# Se vuoto vale: programmazione, informatica, intelligenza artificiale.
# Con AMBITO=libero il filtro è spento.
AMBITO=
MAX_CARATTERI_DOMANDA=4000
MAX_RICHIESTE_AL_MINUTO=10
MAX_RICHIESTE_SESSIONE=50

# --- Agente (tutte facoltative) ---
# L'unica cartella in cui gli strumenti possono leggere e scrivere.
AREA_LAVORO=area_lavoro
MAX_PASSI_AGENTE=8
TEMPO_MASSIMO_SCRIPT=10
