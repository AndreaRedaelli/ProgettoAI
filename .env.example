# Copia questo file in ".env" e inserisci la chiave del fornitore che usi.

# Quale AI usare: groq (gratuito, predefinito) oppure anthropic
AI_PROVIDER=groq

# Chiave Groq: si crea su https://console.groq.com
GROQ_API_KEY=

# Chiave Anthropic (a pagamento): si crea su https://console.anthropic.com
ANTHROPIC_API_KEY=

# Facoltativo: modello da usare. Se vuoto, vale il predefinito del fornitore:
#   groq      -> openai/gpt-oss-120b
#   anthropic -> claude-opus-5-5 (alternative: claude-sonnet-5-5, claude-haiku-5-5)
MODELLO=

# Facoltativo, solo Anthropic: quanto "si impegna" il modello (low, medium, high)
EFFORT=medium
